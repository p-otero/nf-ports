{
  "name": "nf-ports",
  "version": "0.1.0",
  "description": "Per-worktree ports, .localhost names and e2e wiring through portless, plus T3 Code project scripts",
  "keywords": [
    "portless",
    "worktree",
    "localhost",
    "playwright",
    "t3code"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "nfp": "dist/bin.js"
  },
  "files": [
    "dist",
    "preload",
    "scripts/hidden-desktop.ps1",
    "nfp.schema.json"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target node --format esm --outfile dist/bin.js",
    "lint": "oxlint --deny-warnings src test preload",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "portless": "0.18.1"
  },
  "devDependencies": {
    "@p-otero/oxlint-rules": "github:p-otero/oxlint-rules#835a22baa11bdd98e5e2d5818de71dc84e66849d",
    "@types/bun": "1.4.4",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  }
}
